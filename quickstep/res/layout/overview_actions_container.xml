<com.android.quickstep.views.OverviewActionsView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|bottom">

    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/clear_all_container"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.android.quickstep.views.OverviewClearAllButton
                android:id="@+id/action_clear_all"
                style="@style/OverviewActionButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="168dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/recents_clear_all_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
        	android:id="@+id/second_overview_actions_container"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Space
                android:id="@+id/action_screenshot_space"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <com.android.quickstep.views.OverviewActionImageButton
                android:id="@+id/action_screenshot"
                style="@style/OverviewActionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_screenshot"
                android:tint="?android:attr/textColorPrimary"
                android:theme="@style/ThemeControlHighlightWorkspaceColor"
                android:visibility="gone" />

            <Space
                android:id="@+id/action_split_space"
                android:layout_width="12dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <com.android.quickstep.views.OverviewActionImageButton
                android:id="@+id/action_split"
                style="@style/OverviewActionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:tint="?android:attr/textColorPrimary"
                android:theme="@style/ThemeControlHighlightWorkspaceColor"
                android:visibility="gone" />

            <Space
                android:id="@+id/action_lens_space"
                android:layout_width="12dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <com.android.quickstep.views.OverviewActionImageButton
                android:id="@+id/action_lens"
                style="@style/OverviewActionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lens"
                android:tint="?android:attr/textColorPrimary"
                android:theme="@style/ThemeControlHighlightWorkspaceColor"
                android:visibility="gone" />

            <Space
                android:id="@+id/end_space"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="gone" />

        </LinearLayout>
        
    </LinearLayout>

    <!-- Currently, the only "group action button" is this save app pair button. If more are added,
    a new LinearLayout may be needed to contain them, but beware of increased memory usage. -->
    <com.android.quickstep.views.OverviewActionImageButton
        android:id="@+id/action_save_app_pair"
        style="@style/OverviewActionButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="?android:attr/textColorPrimary"
        android:theme="@style/ThemeControlHighlightWorkspaceColor"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="gone" />

    <!-- Lock pill indicator shown during swipe-down-to-lock gesture -->
    <FrameLayout
        android:id="@+id/lock_pill_container"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:visibility="gone"
        android:elevation="4dp"
        android:background="@drawable/bg_overview_actions_button"
        android:backgroundTint="@color/materialColorSecondaryContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/lock_pill_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_protected_locked"
                android:tint="@color/materialColorOnSecondaryContainer"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/lock_pill_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/lock_app_prompt"
                android:textColor="@color/materialColorOnSecondaryContainer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </FrameLayout>

</com.android.quickstep.views.OverviewActionsView>
